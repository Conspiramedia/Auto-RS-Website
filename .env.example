# ============================================================
# RS AUTO — сайт. Шаблон переменных окружения.
# Скопируйте файл в .env.local и подставьте значения.
# ВАЖНО: .env.local в .gitignore и НЕ коммитится.
# ============================================================

# URL проекта Supabase (Settings → API → Project URL).
# Тот же проект, что использует приложение: сайт — второй клиент, не отдельная база.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Публичный анонимный ключ (Settings → API → anon public).
# Безопасен на клиенте ТОЛЬКО при включённом RLS — он включён во всех таблицах.
# Сайту хватает анонимного ключа: весь публичный контент доступен через RLS
# и SECURITY DEFINER RPC. Сервисный ключ нужен только разовым скриптам из
# scripts/ (см. блок в конце файла) и в сборку сайта не попадает.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Базовый адрес сайта. Используется для canonical, OG-тегов и sitemap.xml —
# им нужны абсолютные URL. Без завершающего слэша.
# Домен пока не куплен; после покупки поменять здесь И на сервере командой
# из-под администратора: select public.set_site_base_url('https://ваш-домен');
NEXT_PUBLIC_SITE_BASE_URL=https://rsauto.placeholder


# ============================================================
# ТОЛЬКО ДЛЯ РАЗОВЫХ ЛОКАЛЬНЫХ СКРИПТОВ (scripts/).
# Сайту эти ключи НЕ нужны: в приложение Next они не попадают
# (нет префикса NEXT_PUBLIC_) и на Vercel не задаются.
# ============================================================

# Сервисный ключ Supabase (Settings → API → service_role, secret).
# Работает в ОБХОД RLS, поэтому в браузер попасть не должен никогда.
# Нужен scripts/seed-demo-photos.mjs: фото демо-объявлений заливаются от
# имени служебного продавца, под которым нельзя войти обычным способом.
SUPABASE_SERVICE_ROLE_KEY=

# Ключ фотостока для того же скрипта — достаточно одного из двух.
# Unsplash: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# Pexels:   https://www.pexels.com/api/
PEXELS_API_KEY=
