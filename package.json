{
  "name": "auto-rs-website",
  "version": "1.0.0",
  "private": true,
  "description": "RS Auto — сайт маркетплейса автомобилей (Сербия). Второй клиент того же Supabase, что и приложение.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-suggestions.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "//test": "Тесты ВСЕГДА идут через dotenv -e .env.test: он перекрывает .env.local, который указывает на БОЕВОЙ Supabase. Второй рубеж — tests/env.ts, он падает при попытке запуска против прода.",
    "test": "npm run test:e2e",
    "test:e2e": "dotenv -e .env.test -- playwright test",
    "test:e2e:ui": "dotenv -e .env.test -- playwright test --ui",
    "test:seo": "dotenv -e .env.test -- playwright test seo.spec.ts",
    "test:a11y": "dotenv -e .env.test -- playwright test a11y.spec.ts",
    "test:report": "playwright show-report",
    "//sql": "SQL-тесты серверных гейтов. Требуют поднятого локального Supabase.",
    "test:sql": "node scripts/run-sql-checks.mjs",
    "//supabase": "Локальный стек в Docker. start поднимает, reset пересобирает базу с нуля и заливает seed.",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "//lhci": "Lighthouse CI — бюджеты производительности и SEO.",
    "lhci": "lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "^16.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
