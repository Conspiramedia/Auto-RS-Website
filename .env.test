# ============================================================
# RS AUTO — переменные окружения ДЛЯ ТЕСТОВ.
# ============================================================
# Файл КОММИТИТСЯ намеренно, в отличие от .env.local. Секретов здесь
# нет: адреса локальные, а ключ ниже — публичный демо-ключ локального
# стека Supabase, одинаковый у всех разработчиков и в CI. Он часть
# контракта Supabase CLI, а не тайна.
#
# ЗАЧЕМ ОТДЕЛЬНЫЙ ФАЙЛ. .env.local в этом проекте указывает на БОЕВОЙ
# Supabase, и без перекрытия тесты пошли бы туда: создавали бы живые
# объявления и тратили настоящие квоты OTP. Next читает .env.test
# при NODE_ENV=test, а скрипты тестов подставляют значения явно
# (см. package.json → test:e2e), поэтому перекрытие срабатывает
# независимо от режима.
#
# Дополнительный рубеж — tests/env.ts: он падает с ошибкой, если
# адрес указывает на боевой домен, даже если этот файл потеряется.
# ============================================================

# Локальный Supabase (supabase start). Порт из supabase/config.toml.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Публичный anon-ключ локального стека. НЕ секрет: одинаков у всех
# локальных установок Supabase CLI и без запущенного стека бесполезен.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Базовый адрес сайта под тестами. От него зависят canonical, hreflang,
# og:url и содержимое sitemap.xml — SEO-сьют сверяет их именно с ним.
NEXT_PUBLIC_SITE_BASE_URL=http://127.0.0.1:3100

# Аналитика в тестах выключена: при пустом значении скрипт не
# подключается вовсе (см. lib/analytics.ts), и заходы Playwright не
# попадают в статистику.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
